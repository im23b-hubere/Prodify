{
  "expo": {
    "name": "Prodify",
    "description": "Prodify — studio sessions, streaks, and focus.",
    "slug": "prodify",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prodify",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prodify.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Prodify sends reminders to help you keep your studio streak.",
        "NSPhotoLibraryUsageDescription": "Prodify needs access to your photos so you can set a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prodify.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "@sentry/react-native",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "de", "fr", "es", "it", "pt-BR"],
            "android": ["en", "de", "fr", "es", "it", "pt-BR"]
          },
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Prodify needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "imageWidth": 84
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "locales": {
      "en": "./locales/native/en.json",
      "de": "./locales/native/de.json",
      "fr": "./locales/native/fr.json",
      "es": "./locales/native/es.json",
      "it": "./locales/native/it.json",
      "pt-BR": "./locales/native/pt-BR.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://prodify-api-46b1.onrender.com",
      "eas": {
        "projectId": "1f147cce-39c0-4a4c-81c6-03637bc0f628"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f147cce-39c0-4a4c-81c6-03637bc0f628"
    }
  }
}
