{
  "name": "prodify",
  "description": "Prodify — create beats, share tracks, and build your sound.",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --go --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\"",
    "audit:production": "node scripts/audit-production-deps.mjs",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo",
    "cacheDirectory": "<rootDir>/.jest-cache",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx)",
      "**/*.(test|spec).(ts|tsx)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|react-native-svg|lucide-react-native)"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.19",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "i18next": "^26.0.6",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.10.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "private": true
}
