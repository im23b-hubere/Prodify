# Local development template. Copy to .env and replace the generated secrets.
# For deployments use .env.production.example instead.

# Database
DATABASE_URL=sqlite:///./prodify.db

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-generated-secret-key-min-32-chars
WEBHOOK_SECRET=replace-with-generated-webhook-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# External Services
# Leave empty in development; Sentry init is skipped when unset.
SENTRY_DSN=
# Optional; defaults are fine if unset. Match your Sentry project environment filter.
# SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.15
REVENUECAT_SECRET_KEY=your-rc-api-key
REVENUECAT_WEBHOOK_AUTH=your-rc-webhook-auth
LEGAL_PRIVACY_URL=https://prodify.app/privacy
LEGAL_TERMS_URL=https://prodify.app/terms
LEGAL_EFFECTIVE_DATE=2026-04-20
LEGAL_VERSION=2026.04
SUPPORT_EMAIL=support@prodify.app
FEATURE_FLAG_BILLING_SYNC_ENABLED=true
FEATURE_FLAG_PUSH_NOTIFICATIONS_ENABLED=true
FEATURE_FLAG_SMART_NUDGES_ENABLED=true

# Push Notifications
FCM_SERVER_KEY=your-fcm-key
APNS_KEY_ID=your-apns-key
APNS_TEAM_ID=your-team-id
EXPO_ACCESS_TOKEN=your-expo-access-token
PUSH_ASYNC_BACKEND=threadpool
PUSH_ASYNC_MAX_WORKERS=4

# Object storage (Cloudflare R2 / S3-compatible). Leave unset in development to
# store profile pictures on local disk under backend/uploads/.
# OBJECT_STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_BUCKET=prodify-media
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.prodify.app
# OBJECT_STORAGE_REGION=auto

# Environment
ENVIRONMENT=development
INTERNAL_JOB_KEY=dev-internal-job-key-at-least-24
LOG_JSON=false
# Keep strict in normal operation; set false temporarily for rolling deploy compatibility windows.
STARTUP_SCHEMA_STRICT=true
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006"]
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_AUTH_REGISTER=5/minute
