# Production template for backend deployment.
# Do not commit real secrets. Populate values in your hosting secret manager.

ENVIRONMENT=production
LOG_JSON=true
# Keep strict in normal operation; set false temporarily for rolling deploy compatibility windows.
STARTUP_SCHEMA_STRICT=true

# Use a server database in production (PostgreSQL recommended).
# Example format: postgresql+psycopg://user:password@db-host:5432/prodify
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-strong-secret-key-min-50-chars>

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_JOB_KEY=<generate-strong-internal-job-key-min-24-chars>

# Production CORS must be explicit HTTPS origins only.
CORS_ORIGINS=["https://prodify.app","https://www.prodify.app"]

# Sentry (required when ENVIRONMENT=production)
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
SENTRY_TRACES_SAMPLE_RATE=0.15

# Auth settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# RevenueCat / billing. The secret API key (sk_...) is required: every purchase state is
# verified against RevenueCat. PREMIUM_ENTITLEMENT_NAME must equal the entitlement identifier
# in RevenueCat and EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID in the app.
REVENUECAT_SECRET_KEY=<revenuecat_secret_key>
PREMIUM_ENTITLEMENT_NAME=app_access
# Webhook auth: set the same value as the Authorization header in RevenueCat → Webhooks,
# and/or the HMAC signing secret if webhook signing is enabled there.
REVENUECAT_WEBHOOK_AUTH=<revenuecat_webhook_auth>
REVENUECAT_WEBHOOK_SIGNING_SECRET=<revenuecat_webhook_signing_secret>

# Legal / support metadata
LEGAL_PRIVACY_URL=https://prodify.app/privacy
LEGAL_TERMS_URL=https://prodify.app/terms
LEGAL_EFFECTIVE_DATE=2026-04-22
LEGAL_VERSION=2026.04
SUPPORT_EMAIL=support@prodify.app

# Sign in with Apple / Google (comma-separated lists)
APPLE_BUNDLE_IDS=com.prodify.app
# "Sign in with Apple" key (.p8) — required by App Review to revoke Apple sign-in on account deletion.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Web, iOS and Android OAuth client ids from Google Cloud Console.
GOOGLE_CLIENT_IDS=

# Feature flags
FEATURE_FLAG_BILLING_SYNC_ENABLED=true
FEATURE_FLAG_PUSH_NOTIFICATIONS_ENABLED=true
FEATURE_FLAG_SMART_NOTIFICATIONS_ENABLED=false

# Optional push providers
FCM_SERVER_KEY=<fcm_server_key>
APNS_KEY_ID=<apns_key_id>
APNS_TEAM_ID=<apns_team_id>
EXPO_ACCESS_TOKEN=<expo_access_token>
PUSH_ASYNC_BACKEND=threadpool
PUSH_ASYNC_MAX_WORKERS=4

# Cloudflare R2 (S3-compatible) — required in production so profile pictures
# survive deploys. Create a public bucket (or custom domain) and API token with
# Object Read & Write. Public base URL is what clients load images from.
#
# Endpoint must be the account S3 API host WITHOUT the bucket name:
#   https://<accountid>.r2.cloudflarestorage.com
# Public URL can be the r2.dev subdomain or a custom domain:
#   https://pub-xxxxx.r2.dev
OBJECT_STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=<r2_access_key_id>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<r2_secret_access_key>
OBJECT_STORAGE_BUCKET=prodify-media
OBJECT_STORAGE_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
OBJECT_STORAGE_REGION=auto
